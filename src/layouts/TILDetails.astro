---
import { render, type CollectionEntry } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import { SITE } from "@/config";

export interface Props {
  til: CollectionEntry<"til">;
}

const { til } = Astro.props;

const {
  title,
  author,
  date,
  category,
  source,
  tags,
} = til.data;

const { Content } = await render(til);

const ogUrl = new URL(
  `/til/${til.id}.png`,
  Astro.url.origin
).href;
const ogImageUrl = ogUrl;
---

<Layout
  title={`${title} | ${SITE.title}`}
  author={author}
  description={title}
  ogImage={ogImageUrl}
  canonicalURL={`${SITE.website}til/${til.id}/`}
  date={date}
  modDatetime={null}
  scrollSmooth={true}
>
  <Header />
  
  <div class="til-container">
    <main id="main-content" class="til-main">
      <article class="til-article">
        <header class="til-header">
          <div class="til-badge">Today I Learned</div>
          <h1 class="til-title">{title}</h1>
          
          <div class="til-meta">
            <time class="til-date">
              {date.toLocaleDateString("en-US", {
                year: "numeric",
                month: "long", 
                day: "numeric"
              })}
            </time>
            
            {category && (
              <span class="til-category">{category}</span>
            )}
          </div>
        </header>

        <div class="til-content">
          <Content />
        </div>

        {source && (
          <footer class="til-footer">
            <div class="til-source">
              <strong>Source:</strong> 
              <a href={source} target="_blank" rel="noopener noreferrer">
                {source}
              </a>
            </div>
          </footer>
        )}
      </article>
    </main>
  </div>

  <Footer />
</Layout>

<style>
  .til-container {
    max-width: 800px;
    margin: 0 auto;
    padding: 2rem 1rem;
  }

  .til-main {
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 0;
    padding: 2rem;
    box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
  }

  .til-header {
    margin-bottom: 2rem;
    text-align: center;
  }

  .til-badge {
    display: inline-block;
    background: var(--fg);
    color: white;
    padding: 0.5rem 1rem;
    border-radius: 0;
    font-size: 0.875rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 1rem;
  }

  .til-title {
    font-size: 1.75rem;
    font-weight: 700;
    color: var(--fg);
    margin: 0 0 1rem 0;
    line-height: 1.3;
  }

  .til-meta {
    display: flex;
    justify-content: center;
    gap: 1rem;
    flex-wrap: wrap;
    color: var(--muted);
    font-size: 0.875rem;
  }

  .til-date {
    font-weight: 500;
  }

  .til-category {
    background: var(--border);
    color: var(--fg);
    padding: 0.25rem 0.75rem;
    border-radius: 0;
    font-weight: 600;
    text-transform: uppercase;
    font-size: 0.75rem;
    letter-spacing: 0.05em;
  }

  .til-content {
    font-size: 1rem;
    line-height: 1.7;
    color: var(--fg);
  }

  .til-content :global(h1),
  .til-content :global(h2),
  .til-content :global(h3) {
    color: var(--fg);
    margin: 2rem 0 1rem 0;
  }

  .til-content :global(p) {
    margin-bottom: 1.5rem;
  }

  .til-content :global(code) {
    background: var(--border);
    color: var(--fg);
    padding: 0.125rem 0.375rem;
    border-radius: 0;
    font-size: 0.875rem;
  }

  .til-content :global(pre) {
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: 0;
    padding: 1rem;
    margin: 1.5rem 0;
    overflow-x: auto;
  }

  .til-content :global(pre code) {
    background: none;
    color: var(--fg);
    padding: 0;
  }

  .til-content :global(blockquote) {
    border-left: 4px solid var(--fg);
    padding-left: 1rem;
    margin: 1.5rem 0;
    font-style: italic;
    color: var(--muted);
  }

  .til-content :global(ul),
  .til-content :global(ol) {
    margin: 1rem 0;
    padding-left: 2rem;
  }

  .til-content :global(li) {
    margin-bottom: 0.5rem;
  }

  .til-footer {
    margin-top: 2rem;
    padding-top: 1rem;
    border-top: 1px solid var(--border);
  }

  .til-source {
    font-size: 0.875rem;
    color: var(--muted);
  }

  .til-source a {
    word-break: break-all;
  }

  @media (max-width: 768px) {
    .til-container {
      padding: 1rem 0.5rem;
    }

    .til-main {
      padding: 1.5rem;
    }

    .til-title {
      font-size: 1.5rem;
    }

    .til-meta {
      flex-direction: column;
      align-items: center;
      gap: 0.5rem;
    }
  }
</style>