---
// simple hamburger button for mobile sidebar drawer
---

<button
  id="hamburger-btn"
  class="hamburger-button"
  aria-label="Toggle sidebar menu"
  aria-expanded="false"
>
  <span class="hamburger-line"></span>
  <span class="hamburger-line"></span>
  <span class="hamburger-line"></span>
</button>

<style>
  .hamburger-button {
    display: none;
    flex-direction: column;
    gap: 0.375rem;
    background: none;
    border: none;
    padding: 0.5rem;
    cursor: pointer;
    z-index: 1001;
  }

  @media (max-width: 1023px) {
    .hamburger-button {
      display: flex;
    }
  }

  .hamburger-line {
    width: 1.5rem;
    height: 2px;
    background-color: var(--fg);
    transition: all 0.3s ease;
  }

  .hamburger-button[aria-expanded="true"] .hamburger-line:nth-child(1) {
    transform: rotate(45deg) translate(0.5rem, 0.5rem);
  }

  .hamburger-button[aria-expanded="true"] .hamburger-line:nth-child(2) {
    opacity: 0;
  }

  .hamburger-button[aria-expanded="true"] .hamburger-line:nth-child(3) {
    transform: rotate(-45deg) translate(0.5rem, -0.5rem);
  }
</style>
