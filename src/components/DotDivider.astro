---
export interface Props {
  spacing?: "sm" | "md" | "lg";
}

const { spacing = "md" } = Astro.props;

const spacingMap = {
  sm: "0.5rem",
  md: "1rem",
  lg: "1.5rem"
};

const marginY = spacingMap[spacing];
---

<div class="dot-divider" style={`margin: ${marginY} auto;`}>
<svg class="dot-svg" width="400" height="20" viewBox="0 0 400 20" xmlns="http://www.w3.org/2000/svg" fill="none">
  <line x1="0" y1="10" x2="160" y2="10" stroke="currentColor" stroke-width="1"/>
  <circle cx="190" cy="10" r="1.5" fill="currentColor"/>
  <circle cx="200" cy="10" r="1.5" fill="currentColor"/>
  <circle cx="210" cy="10" r="1.5" fill="currentColor"/>
  <line x1="240" y1="10" x2="400" y2="10" stroke="currentColor" stroke-width="1"/>
</svg>
</div>

<style>
  .dot-divider {
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .dot-svg {
    color: var(--muted);
    opacity: 0.15;
  }
</style>
