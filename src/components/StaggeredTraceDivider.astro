---
export interface Props {
  className?: string;
  opacity?: number;
  strokeWidth?: number;
}

const {
  className = "",
  opacity = 1,
  strokeWidth = 1
} = Astro.props;
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  width="100%"
  height="28"
  viewBox="0 0 1200 28"
  role="img"
  aria-label="subtle staggered trace divider"
  class={`staggered-trace-divider ${className}`}
  style="display:block"
>
  <g
    fill="none"
    stroke="currentColor"
    stroke-width={strokeWidth}
    vector-effect="non-scaling-stroke"
    stroke-linecap="square"
    style={`opacity: ${opacity}`}
  >
    <path d="M0,6 L380,6 420,12 760,12 800,6 1200,6" opacity="0.15"/>
    <path d="M0,12 L300,12 340,18 900,18 940,12 1200,12" opacity="0.20"/>
    <path d="M0,20 L260,20 300,14 880,14 920,20 1200,20" opacity="0.10"/>
  </g>
</svg>

<style>
  .staggered-trace-divider {
    color: var(--fg);
    margin: 0rem 0;
    opacity: 0.6;
    /* transition: opacity 0.3s ease; */
  }

  @media (prefers-reduced-motion: reduce) {
    .staggered-trace-divider {
      transition: none;
    }
  }
</style>
