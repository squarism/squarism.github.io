---
// one card in a list. takes a feed item plus whatever extras the caller has
// for it: a one-line excerpt, tags, a thumbnail
import type { FeedItem } from "@/types/content";

export interface Props {
  item: FeedItem;
  excerpt?: string;
  tags?: string[];
  image?: string | null;
  className?: string;
}

const { item, excerpt = "", tags = [], image = null, className = "" } = Astro.props;

// posts are the plain card; everything else gets a kind class and a kind tag
const kindClass = item.kind !== "post" ? `article-card-${item.kind}` : "";
const combinedClassName = `article-card ${kindClass} ${className}`.trim();
---

<article class={combinedClassName}>
  <div class="article-content">
    <aside class="article-meta">
      <time datetime={item.date.toISOString()} class="article-date">
        {item.date.toLocaleDateString("en-US", {
          month: "short",
          day: "numeric",
          year: "numeric"
        })}
      </time>
      {item.kind !== "post" && (
        <a href={`/${item.kind}/`} class={`post-type-tag tag-${item.kind}`}>
          #{item.kind}
        </a>
      )}
      {tags.length > 0 && (
        <ul class="article-tags">
          {tags.slice(0, 6).map(tag => (
            <li><span class="article-tag">#{tag}</span></li>
          ))}
        </ul>
      )}
    </aside>

    <div class="article-text">
      <h3 class="article-title">
        {item.kind === "devlog" ? (
          <span class="article-link">{item.title}</span>
        ) : (
          <a href={item.url} class="article-link">{item.title}</a>
        )}
      </h3>

      {excerpt && <p class="article-excerpt">{excerpt}</p>}
    </div>

    {image && (
      <div class="article-thumbnail">
        <img src={image} alt={item.title} loading="lazy" />
      </div>
    )}
  </div>
</article>

<style>
  .article-card {
    position: relative;
    margin-bottom: 1.5rem;
    padding: 0 0 1.5rem 1rem;
    border-bottom: 1px solid var(--border);
  }

  /* nier-style left rail + corner block marker */
  .article-card::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.6rem;
    bottom: 1.5rem;
    width: 1px;
    background: var(--border);
  }

  .article-card::after {
    content: "";
    position: absolute;
    left: -2px;
    top: 0.55rem;
    width: 5px;
    height: 5px;
    background: var(--muted);
  }

  .article-card:last-child {
    border-bottom: none;
    margin-bottom: 0;
    padding-bottom: 0;
  }

  /* Hero/Featured article styling */
  .article-card.hero-article {
    margin-bottom: 3rem;
    padding: 2rem;
    border: 1px solid var(--border);
    background: var(--card);
  }

  .article-card.hero-article::before,
  .article-card.hero-article::after {
    display: none;
  }

  .article-content {
    display: grid;
    grid-template-columns: 7rem 1fr 140px;
    gap: 1.25rem;
    align-items: start;
  }

  .article-card:not(:has(.article-thumbnail)) .article-content {
    grid-template-columns: 7rem 1fr;
  }

  .article-thumbnail {
    width: 140px;
    height: 100px;
    overflow: hidden;
    border: 1px solid var(--border);
    padding: 3px;
    background: var(--bg);
  }

  .article-thumbnail img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .hero-article .article-thumbnail {
    width: 180px;
    height: 130px;
  }

  .article-text {
    min-width: 0;
  }

  .article-title {
    font-size: 1.375rem;
    font-weight: 600;
    line-height: 1.3;
    margin: 0 0 0.5rem 0;
    letter-spacing: -0.005em;
  }

  .hero-article .article-title {
    font-size: 2.5rem;
    font-weight: 700;
    line-height: 1.2;
    margin-bottom: 1rem;
  }


  .article-excerpt {
    color: var(--muted);
    line-height: 1.5;
    margin: 0 0 0.75rem 0;
    font-size: 0.9375rem;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .article-tags {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.25rem;
  }

  .article-tag {
    font-size: 0.7rem;
    color: var(--muted);
    text-transform: lowercase;
    letter-spacing: 0.02em;
    border: 1px solid var(--border);
    padding: 0.05rem 0.4rem;
  }

  .hero-article .article-excerpt {
    font-size: 1.125rem;
    line-height: 1.7;
    margin-bottom: 1.5rem;
    color: var(--fg);
    /* show the full <!-- more --> excerpt — no clamp */
    display: block;
    -webkit-line-clamp: none;
    line-clamp: none;
    overflow: visible;
  }

  .article-meta {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.5rem;
    padding-top: 0.25rem;
    font-family: var(--font-mono, ui-monospace, Menlo, monospace);
  }

  .hero-article .article-meta {
    font-size: 1rem;
  }

  .article-date {
    font-size: 0.875rem;
    color: var(--muted);
    font-weight: 500;
  }

  .post-type-tag {
    font-size: 0.75rem;
    font-weight: 500;
    padding: 0.125rem 0.375rem;
    text-decoration: none;
    text-transform: lowercase;
    transition: opacity 0.2s ease;
    color: var(--muted);
    border: 1px solid var(--border);
    background: transparent;
  }

  .post-type-tag:hover {
    opacity: 0.7;
    border-color: var(--muted);
  }

  .tag-til,
  .tag-devlog,
  .tag-bookmark {
    /* all use same muted style */
  }

  .hero-article .article-date {
    font-size: 1rem;
    font-weight: 600;
  }

  @media (max-width: 768px) {
    .hero-article .article-title {
      font-size: 2rem;
    }

    .hero-article {
      padding: 1.5rem;
    }

    .article-content,
    .article-card:not(:has(.article-thumbnail)) .article-content {
      grid-template-columns: 1fr;
      gap: 0.75rem;
    }

    .article-meta {
      flex-direction: row;
      flex-wrap: wrap;
      align-items: center;
      gap: 0.5rem 0.75rem;
      padding-top: 0;
    }

    .article-tags {
      flex-direction: row;
      flex-wrap: wrap;
      gap: 0.25rem 0.4rem;
    }

    .article-thumbnail {
      width: 100%;
      height: 140px;
      order: -1;
    }

    .hero-article .article-thumbnail {
      width: 100%;
      height: 160px;
    }
  }

  /* DevLog post styling - quietly differentiated from blog posts */
  .article-card-devlog .article-title {
    font-size: 1.125rem;
    font-weight: 500;
  }

  .article-card-devlog .article-date {
    font-family: var(--font-mono, ui-monospace, SFMono-Regular, Menlo, monospace);
    font-variant-numeric: tabular-nums;
  }

  /* TIL post styling - deemphasized relative to blog articles */
  .article-card-til {
    opacity: 0.7;
  }

  .article-card-til .article-title {
    font-size: 1.125rem;
    font-weight: 500;
    color: var(--muted);
  }

  .article-card-til .article-excerpt {
    font-size: 0.9rem;
  }

  .article-card-til:hover {
    opacity: 1;
  }

  /* Bookmark post styling - placeholder for user customization */
  .article-card-bookmark {
    background: var(--card);
    border: 1px dashed var(--border);
    padding: 1rem;
  }

  .bookmark-link {
    margin-bottom: 0.75rem;
  }

  .external-link {
    font-size: 0.875rem;
    word-break: break-all;
  }

  /* dark mode adjustments */
  @media (prefers-color-scheme: dark) {
    .article-card-devlog {
      background: #2a2a28;
      border-color: #444;
      color: #d0d0d0;
    }

    .article-card-devlog .article-title {
      color: #e0e0e0;
    }

    .article-card-devlog .article-excerpt {
      color: #d0d0d0;
    }

    .article-card-devlog .article-date {
      color: #999;
    }
  }
</style>
