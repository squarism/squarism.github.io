---
import type { CollectionEntry } from "astro:content";
import type { UnifiedPost } from "@/lib/content";
import { getPostUrl } from "@/lib/content";
import { getPostExcerpt } from "@/utils/excerpt";

export interface Props {
  post: CollectionEntry<"posts"> | CollectionEntry<"til"> | CollectionEntry<"devlog"> | UnifiedPost;
  className?: string;
}

const { post, className = "" } = Astro.props;
const url = getPostUrl(post);
const excerpt = getPostExcerpt(post);

// detect post type
const postType = (post as UnifiedPost).inferredType || ("type" in post.data ? post.data.type : undefined) || "blog";

// Extract first image from markdown content
function getFirstImage(content: string): string | null {
  // Match markdown images: ![alt](src) or HTML images: <img ... src="..." />
  const markdownImageMatch = content.match(/!\[[^\]]*\]\(([^)]+)\)/);
  if (markdownImageMatch) return markdownImageMatch[1];

  const htmlImageMatch = content.match(/<img[^>]+src=["']([^"']+)["'][^>]*>/);
  if (htmlImageMatch) return htmlImageMatch[1];

  return null;
}

const imageUrl = getFirstImage(post.body || "");

// build dynamic class names based on post type
const typeClass = postType !== "blog" ? `article-card-${postType}` : "";
const combinedClassName = `article-card ${typeClass} ${className}`.trim();
---

<article class={combinedClassName}>
  <div class="article-content">
    <aside class="article-meta">
      {"date" in post.data && post.data.date && (
        <time datetime={post.data.date.toISOString()} class="article-date">
          {post.data.date.toLocaleDateString("en-US", {
            month: "short",
            day: "numeric",
            year: "numeric"
          })}
        </time>
      )}
      {postType !== "blog" && (
        <a href={`/${postType}/`} class={`post-type-tag tag-${postType}`}>
          #{postType}
        </a>
      )}
      {"tags" in post.data && Array.isArray(post.data.tags) && post.data.tags.length > 0 && (
        <ul class="article-tags">
          {post.data.tags.slice(0, 6).map((tag: string) => (
            <li><span class="article-tag">#{tag}</span></li>
          ))}
        </ul>
      )}
    </aside>

    <div class="article-text">
      <h3 class="article-title">
        {postType === "devlog" ? (
          <span class="article-link">{post.data.title}</span>
        ) : (
          <a href={url} class="article-link">{post.data.title}</a>
        )}
      </h3>

      <p class="article-excerpt">{excerpt}</p>
    </div>

    {imageUrl && (
      <div class="article-thumbnail">
        <img src={imageUrl} alt={post.data.title} loading="lazy" />
      </div>
    )}
  </div>
</article>

<style>
  .article-card {
    position: relative;
    margin-bottom: 1.5rem;
    padding: 0 0 1.5rem 1rem;
    border-bottom: 1px solid var(--border);
  }

  /* nier-style left rail + corner block marker */
  .article-card::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.6rem;
    bottom: 1.5rem;
    width: 1px;
    background: var(--border);
  }

  .article-card::after {
    content: "";
    position: absolute;
    left: -2px;
    top: 0.55rem;
    width: 5px;
    height: 5px;
    background: var(--muted);
  }

  .article-card:last-child {
    border-bottom: none;
    margin-bottom: 0;
    padding-bottom: 0;
  }

  /* Hero/Featured article styling */
  .article-card.hero-article {
    margin-bottom: 3rem;
    padding: 2rem;
    border: 1px solid var(--border);
    background: var(--card);
  }

  .article-card.hero-article::before,
  .article-card.hero-article::after {
    display: none;
  }

  .article-content {
    display: grid;
    grid-template-columns: 7rem 1fr 140px;
    gap: 1.25rem;
    align-items: start;
  }

  .article-card:not(:has(.article-thumbnail)) .article-content {
    grid-template-columns: 7rem 1fr;
  }

  .article-thumbnail {
    width: 140px;
    height: 100px;
    overflow: hidden;
    border: 1px solid var(--border);
    padding: 3px;
    background: var(--bg);
  }

  .article-thumbnail img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .hero-article .article-thumbnail {
    width: 180px;
    height: 130px;
  }

  .article-text {
    min-width: 0;
  }

  .article-title {
    font-size: 1.375rem;
    font-weight: 600;
    line-height: 1.3;
    margin: 0 0 0.5rem 0;
    letter-spacing: -0.005em;
  }

  .hero-article .article-title {
    font-size: 2.5rem;
    font-weight: 700;
    line-height: 1.2;
    margin-bottom: 1rem;
  }


  .article-excerpt {
    color: var(--muted);
    line-height: 1.5;
    margin: 0 0 0.75rem 0;
    font-size: 0.9375rem;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .article-tags {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.25rem;
  }

  .article-tag {
    font-size: 0.7rem;
    color: var(--muted);
    text-transform: lowercase;
    letter-spacing: 0.02em;
    border: 1px solid var(--border);
    padding: 0.05rem 0.4rem;
  }

  .hero-article .article-excerpt {
    font-size: 1.125rem;
    line-height: 1.7;
    margin-bottom: 1.5rem;
    color: var(--fg);
    /* show the full <!-- more --> excerpt — no clamp */
    display: block;
    -webkit-line-clamp: none;
    line-clamp: none;
    overflow: visible;
  }

  .article-meta {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.5rem;
    padding-top: 0.25rem;
    font-family: var(--font-mono, ui-monospace, Menlo, monospace);
  }

  .hero-article .article-meta {
    font-size: 1rem;
  }

  .article-date {
    font-size: 0.875rem;
    color: var(--muted);
    font-weight: 500;
  }

  .post-type-tag {
    font-size: 0.75rem;
    font-weight: 500;
    padding: 0.125rem 0.375rem;
    text-decoration: none;
    text-transform: lowercase;
    transition: opacity 0.2s ease;
    color: var(--muted);
    border: 1px solid var(--border);
    background: transparent;
  }

  .post-type-tag:hover {
    opacity: 0.7;
    border-color: var(--muted);
  }

  .tag-til,
  .tag-devlog,
  .tag-bookmark {
    /* all use same muted style */
  }

  .hero-article .article-date {
    font-size: 1rem;
    font-weight: 600;
  }

  @media (max-width: 768px) {
    .hero-article .article-title {
      font-size: 2rem;
    }

    .hero-article {
      padding: 1.5rem;
    }

    .article-content,
    .article-card:not(:has(.article-thumbnail)) .article-content {
      grid-template-columns: 1fr;
      gap: 0.75rem;
    }

    .article-meta {
      flex-direction: row;
      flex-wrap: wrap;
      align-items: center;
      gap: 0.5rem 0.75rem;
      padding-top: 0;
    }

    .article-tags {
      flex-direction: row;
      flex-wrap: wrap;
      gap: 0.25rem 0.4rem;
    }

    .article-thumbnail {
      width: 100%;
      height: 140px;
      order: -1;
    }

    .hero-article .article-thumbnail {
      width: 100%;
      height: 160px;
    }
  }

  /* DevLog post styling - quietly differentiated from blog posts */
  .article-card-devlog .article-title {
    font-size: 1.125rem;
    font-weight: 500;
  }

  .article-card-devlog .article-date {
    font-family: var(--font-mono, ui-monospace, SFMono-Regular, Menlo, monospace);
    font-variant-numeric: tabular-nums;
  }

  /* TIL post styling - deemphasized relative to blog articles */
  .article-card-til {
    opacity: 0.7;
  }

  .article-card-til .article-title {
    font-size: 1.125rem;
    font-weight: 500;
    color: var(--muted);
  }

  .article-card-til .article-excerpt {
    font-size: 0.9rem;
  }

  .article-card-til:hover {
    opacity: 1;
  }

  /* Bookmark post styling - placeholder for user customization */
  .article-card-bookmark {
    background: var(--card);
    border: 1px dashed var(--border);
    padding: 1rem;
  }

  .bookmark-link {
    margin-bottom: 0.75rem;
  }

  .external-link {
    font-size: 0.875rem;
    word-break: break-all;
  }

  /* dark mode adjustments */
  @media (prefers-color-scheme: dark) {
    .article-card-devlog {
      background: #2a2a28;
      border-color: #444;
      color: #d0d0d0;
    }

    .article-card-devlog .article-title {
      color: #e0e0e0;
    }

    .article-card-devlog .article-excerpt {
      color: #d0d0d0;
    }

    .article-card-devlog .article-date {
      color: #999;
    }
  }
</style>
