---
// links: mirrors the til index. one row per bookmark, linking out. content
// comes from src/content/links, to be filled by a pinboard import tool.
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import { getCollection } from "astro:content";
import { SITE } from "@/config";

const linkEntries = await getCollection("links", ({ data }) => !data.draft);
const sortedLinks = linkEntries.sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime()
);

const fmtDate = (d: Date) =>
  d.toLocaleDateString("en-US", { year: "numeric", month: "short", day: "2-digit" });
---

<Layout title={`Links | ${SITE.title}`}>
  <Header />
  <main id="main-content" class="links-index">
    <header class="links-header">
      <h1>Links</h1>
      <p class="links-description">
        Bookmarks worth keeping, with a note on why.
      </p>
    </header>

    {sortedLinks.length > 0 ? (
      <ul class="links-list">
        {sortedLinks.map(link => (
          <li class="links-item">
            <time class="links-date" datetime={link.data.date.toISOString()}>
              {fmtDate(link.data.date)}
            </time>
            <div class="links-body">
              <a class="links-link" href={link.data.url} rel="noopener">
                {link.data.title}
              </a>
              {link.data.description && (
                <p class="links-note">{link.data.description}</p>
              )}
            </div>
          </li>
        ))}
      </ul>
    ) : (
      <p class="no-links">Nothing here yet.</p>
    )}
  </main>
  <Footer />
</Layout>

<style>
  .links-index {
    max-width: 56rem;
    margin: 0 auto;
    padding: 2rem 1.5rem 3rem;
  }

  .links-header {
    margin-bottom: 2.5rem;
  }

  .links-header h1 {
    font-size: var(--text-3xl);
    font-weight: 700;
    color: var(--fg);
    margin: 0 0 0.5rem 0;
    line-height: var(--leading-tight);
  }

  .links-description {
    font-size: 1rem;
    color: var(--muted);
    line-height: var(--leading-normal);
    max-width: 36rem;
    margin: 0;
  }

  .links-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
  }

  .links-item {
    display: grid;
    grid-template-columns: 7rem 1fr;
    align-items: baseline;
    gap: 1rem;
    padding: 0.625rem 0;
    border-bottom: 1px dotted var(--border);
  }

  .links-item:last-child {
    border-bottom: none;
  }

  .links-date {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--muted);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  .links-body {
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .links-link {
    font-size: 1rem;
    line-height: 1.4;
    font-weight: 500;
  }

  .links-note {
    margin: 0;
    font-size: 0.9375rem;
    line-height: 1.5;
    color: var(--muted);
  }

  @media (max-width: 640px) {
    .links-item {
      grid-template-columns: 5.5rem 1fr;
      gap: 0.75rem;
    }
  }

  .no-links {
    color: var(--muted);
    text-align: center;
    padding: 4rem 0;
  }
</style>
