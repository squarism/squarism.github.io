---
// home. design ref: claude design screen 4a. hero + recent list in the main
// column, devlog / til / links in a sidebar that stacks below on small
// screens.
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import { getCollection } from "astro:content";
import {
  getUnifiedFeed,
  getHeroPost,
  getPostUrl,
  getFeatures,
  getFeatureUrl,
  getHeroFeature,
} from "@/lib/content";
import { getHeroExcerpt } from "@/utils/excerpt";

const RECENT_LIMIT = 10;
const SIDEBAR_LIMIT = 3;
const FEATURES_LIMIT = 4;

const [feed, heroPost, links, features, heroFeature] = await Promise.all([
  getUnifiedFeed({ excludeDrafts: true }),
  getHeroPost(),
  getCollection("links", ({ data }) => !data.draft),
  getFeatures(),
  getHeroFeature(),
]);

// the hero feature is shown big above the list, so keep it out of the list
const listedFeatures = features
  .filter(f => f.id !== heroFeature?.id)
  .slice(0, FEATURES_LIMIT);

const recent = feed
  .filter(p => p.inferredType === "blog" && p.id !== heroPost?.id)
  .slice(0, RECENT_LIMIT);

interface SidebarItem {
  title: string;
  date: Date;
  url: string;
}

interface SidebarSection {
  title: string;
  href: string;
  items: SidebarItem[];
}

const toItem = (p: {
  data: { title: string; date: Date };
  url: string;
}): SidebarItem => ({
  title: p.data.title,
  date: p.data.date,
  url: p.url,
});

const sidebar: SidebarSection[] = [
  {
    title: "devlog",
    href: "/devlog/",
    items: feed
      .filter(p => p.inferredType === "devlog")
      .slice(0, SIDEBAR_LIMIT)
      .map(toItem),
  },
  {
    title: "til",
    href: "/til/",
    items: feed
      .filter(p => p.inferredType === "til")
      .slice(0, SIDEBAR_LIMIT)
      .map(toItem),
  },
  {
    title: "links",
    href: "/links/",
    items: [...links]
      .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
      .slice(0, SIDEBAR_LIMIT)
      .map(l => ({ title: l.data.title, date: l.data.date, url: l.data.url })),
  },
];

const fmtDay = (d: Date) =>
  d.toLocaleDateString("en-US", {
    month: "short",
    day: "numeric",
    timeZone: "UTC",
  });
const fmtIso = (d: Date) => d.toISOString().slice(0, 10);
---

<Layout>
  <Header />

  <main id="main-content" class="home" data-layout="index">
    <div class="home-main">
      {
        heroFeature && (
          <section class="hero">
            <div class="hero-meta">
              <span class="hero-flag">
                <i aria-hidden="true" />
                feature
              </span>
              <span class="sep" aria-hidden="true">
                /
              </span>
              <time datetime={heroFeature.data.date.toISOString()}>
                {fmtIso(heroFeature.data.date)}
              </time>
              {heroFeature.data.tags.map(tag => (
                <>
                  <span class="sep" aria-hidden="true">
                    /
                  </span>
                  <span>#{tag}</span>
                </>
              ))}
            </div>
            <h2 class="hero-title">
              <a href={getFeatureUrl(heroFeature)}>{heroFeature.data.title}</a>
            </h2>
            <p class="hero-excerpt">{heroFeature.data.description}</p>
          </section>
        )
      }

      {
        listedFeatures.length > 0 && (
          <section class="features-block">
            <div class="list-head">
              <span>features</span>
              <a href="/features/">all features →</a>
            </div>
            <ul class="feature-list">
              {listedFeatures.map(feature => (
                <li>
                  <time datetime={feature.data.date.toISOString()}>
                    {fmtDay(feature.data.date)}
                  </time>
                  <div class="feature-row">
                    <a href={getFeatureUrl(feature)}>{feature.data.title}</a>
                    {feature.data.tags[0] && (
                      <span class="tag">#{feature.data.tags[0]}</span>
                    )}
                  </div>
                </li>
              ))}
            </ul>
          </section>
        )
      }

      {
        heroPost && (
          <section class="hero">
            <div class="hero-meta">
              <span class="hero-flag">
                <i aria-hidden="true" />
                featured
              </span>
              <span class="sep" aria-hidden="true">
                /
              </span>
              <time datetime={heroPost.data.date.toISOString()}>
                {fmtIso(heroPost.data.date)}
              </time>
              {heroPost.data.tags.map(tag => (
                <>
                  <span class="sep" aria-hidden="true">
                    /
                  </span>
                  <span>#{tag}</span>
                </>
              ))}
            </div>
            <h1 class="hero-title">
              <a href={getPostUrl(heroPost)}>{heroPost.data.title}</a>
            </h1>
            <p class="hero-excerpt">{getHeroExcerpt(heroPost)}</p>
          </section>
        )
      }

      <section class="recent">
        <div class="list-head">
          <span>posts</span>
          <a href="/posts/">full index →</a>
        </div>
        <ul class="recent-list">
          {
            recent.map(post => (
              <li>
                <time datetime={post.data.date.toISOString()}>
                  {fmtDay(post.data.date)}
                </time>
                <a href={post.url}>{post.data.title}</a>
              </li>
            ))
          }
        </ul>
      </section>
    </div>

    <aside class="home-side">
      {
        sidebar.map(section => (
          <section class="side-section">
            <h2 class="side-title">
              <a href={section.href}>{section.title}</a>
            </h2>
            {section.items.length === 0 ? (
              <p class="side-empty">nothing yet</p>
            ) : (
              <ul class="side-list">
                {section.items.map(item => (
                  <li>
                    <time datetime={item.date.toISOString()}>
                      {fmtDay(item.date)}
                    </time>
                    <a href={item.url}>{item.title}</a>
                  </li>
                ))}
              </ul>
            )}
          </section>
        ))
      }
    </aside>
  </main>

  <Footer />
</Layout>

<style>
  .home {
    width: 100%;
    box-sizing: border-box;
    padding: 64px var(--header-pad-x) 80px;
    display: grid;
    grid-template-columns: minmax(0, 1fr) 300px;
    gap: 64px;
    align-items: start;
  }

  /* the global section rule centres and shrinks flex/grid children */
  .home section {
    width: 100%;
    max-width: none;
    margin: 0;
    padding: 0;
  }

  .home-main {
    min-width: 0;
  }

  /* ----- features block: same list as posts, first tag beside the title ----- */
  .home .features-block {
    margin-bottom: 40px;
  }
  .feature-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .feature-list li {
    display: grid;
    grid-template-columns: 86px minmax(0, 1fr);
    align-items: baseline;
    gap: 16px;
    padding: 20px 0;
    border-bottom: 1px solid var(--border);
  }
  .feature-list time {
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--muted);
    white-space: nowrap;
  }
  .feature-row {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 6px 14px;
  }
  .feature-list a {
    font-size: 20px;
    font-weight: 500;
    letter-spacing: -0.015em;
    color: var(--fg);
    border-bottom: 0;
    text-wrap: pretty;
  }
  .feature-list a:hover {
    color: var(--accent-text);
  }
  .tag {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--muted);
  }

  /* ----- hero ----- */
  .home .hero {
    padding-bottom: 40px;
    margin-bottom: 40px;
    border-bottom: 1px solid var(--border);
  }
  .hero-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 16px;
    margin-bottom: 20px;
    font-family: var(--font-mono);
    font-size: 13px;
    letter-spacing: 0.02em;
    color: var(--muted);
  }
  .hero-flag {
    display: inline-flex;
    align-items: center;
    gap: 10px;
  }
  .hero-flag i {
    width: 7px;
    height: 7px;
    background: var(--accent);
  }
  .hero-meta .sep {
    color: var(--faint);
  }
  .hero-title {
    margin: 0 0 20px;
    font-size: 48px;
    font-weight: 600;
    line-height: 1.05;
    letter-spacing: -0.035em;
    text-wrap: pretty;
  }
  .hero-title a {
    color: var(--fg);
    border-bottom: 0;
  }
  .hero-title a:hover {
    color: var(--accent-text);
  }
  .hero-excerpt {
    margin: 0;
    max-width: 62ch;
    font-size: 19px;
    line-height: 1.55;
    color: var(--body);
    text-wrap: pretty;
  }

  /* ----- list heads, shared by features and posts ----- */
  .list-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    padding-bottom: 12px;
    border-bottom: 1px solid var(--border);
    font-family: var(--font-mono);
    font-size: 13px;
    letter-spacing: 0.02em;
    color: var(--muted);
  }
  .list-head a {
    color: var(--muted);
  }
  .list-head a:hover {
    color: var(--accent-text);
  }

  /* ----- recent posts ----- */
  .recent-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .recent-list li {
    display: grid;
    grid-template-columns: 86px minmax(0, 1fr);
    align-items: baseline;
    gap: 16px;
    padding: 20px 0;
    border-bottom: 1px solid var(--border);
  }
  .recent-list time {
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--muted);
    white-space: nowrap;
  }
  .recent-list a {
    font-size: 20px;
    font-weight: 500;
    letter-spacing: -0.015em;
    color: var(--fg);
    border-bottom: 0;
    text-wrap: pretty;
  }
  .recent-list a:hover {
    color: var(--accent-text);
  }

  /* ----- sidebar ----- */
  .home-side {
    display: flex;
    flex-direction: column;
    gap: 44px;
    min-width: 0;
  }
  .side-title {
    margin: 0 0 12px;
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 400;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .side-title a {
    color: var(--muted);
    border-bottom: 0;
  }
  .side-title a:hover {
    color: var(--accent-text);
  }
  .side-list {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--border);
  }
  .side-list li {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 14px 0;
    border-bottom: 1px solid var(--border);
  }
  .side-list time {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--muted);
  }
  .side-list a {
    font-size: 16px;
    line-height: 1.35;
    color: var(--body);
    border-bottom: 0;
    text-wrap: pretty;
  }
  .side-list a:hover {
    color: var(--accent-text);
  }
  .side-empty {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--muted);
  }

  @media (max-width: 900px) {
    .home {
      grid-template-columns: minmax(0, 1fr);
      gap: 48px;
      padding: 40px 20px 56px;
    }
    .home-side {
      padding-top: 40px;
      border-top: 1px solid var(--border);
    }
    .hero-title {
      font-size: 34px;
    }
    .hero-excerpt {
      font-size: 17px;
    }
    .feature-list li {
      grid-template-columns: 1fr;
      gap: 4px;
      padding: 14px 0;
    }
    .feature-list a {
      font-size: 18px;
    }
    .recent-list li {
      grid-template-columns: 1fr;
      gap: 4px;
      padding: 14px 0;
    }
    .recent-list a {
      font-size: 18px;
    }
  }
</style>

<script>
  document.addEventListener("astro:page-load", () => {
    const indexLayout = (document.querySelector("#main-content") as HTMLElement)
      ?.dataset?.layout;
    if (indexLayout) {
      sessionStorage.setItem("backUrl", "/");
    }
  });
</script>
