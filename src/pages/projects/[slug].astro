---
// /projects/<slug>: one project. title, year, repo and live links, the image
// shown whole, then the markdown write-up in the site's prose style.
import { getCollection, render } from "astro:content";
import { Image } from "astro:assets";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import { SITE } from "@/config";

export async function getStaticPaths() {
  const projects = await getCollection("projects", ({ data }) => !data.draft);
  return projects.map(project => ({
    params: { slug: project.id },
    props: { project },
  }));
}

const { project } = Astro.props;
const { title, description, date, repo, link, image } = project.data;
const { Content } = await render(project);
---

<Layout title={`${title} | ${SITE.title}`} description={description}>
  <Header />
  <main id="main-content" class="project-page">
    <a class="project-back" href="/projects/">← projects</a>

    <header class="project-head">
      <h1 class="project-title">{title}</h1>
      <p class="project-meta">
        <span>{date.getUTCFullYear()}</span>
        {repo && <a href={repo}>{repo.replace(/^https?:\/\//, "")}</a>}
        {link && <a href={link}>{link.replace(/^https?:\/\//, "")}</a>}
      </p>
    </header>

    {
      image && (
        <figure class="project-figure">
          <Image src={image} alt={`${title} screenshot`} width={1200} />
        </figure>
      )
    }

    <article class="app-prose project-content">
      <Content />
    </article>
  </main>
  <Footer />
</Layout>

<style>
  .project-page {
    width: 100%;
    max-width: 760px;
    margin: 0 auto;
    box-sizing: border-box;
    padding: 64px var(--header-pad-x) 80px;
  }

  .project-back {
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--muted);
    border-bottom: 0;
  }
  .project-back:hover {
    color: var(--accent-text);
  }

  .project-head {
    margin: 24px 0 32px;
  }

  .project-title {
    margin: 0 0 12px;
    font-size: 40px;
    font-weight: 600;
    line-height: 1.05;
    letter-spacing: -0.035em;
    color: var(--fg);
  }

  .project-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 20px;
    margin: 0;
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--muted);
  }
  .project-meta a {
    color: var(--muted);
  }
  .project-meta a:hover {
    color: var(--accent-text);
  }

  .project-figure {
    margin: 0 0 40px;
  }
  .project-figure img {
    display: block;
    width: 100%;
    height: auto;
    border: 1px solid var(--border);
    box-sizing: border-box;
  }

  .project-content {
    font-size: 17px;
    line-height: 1.65;
  }

  @media (max-width: 800px) {
    .project-page {
      padding: 40px 20px 56px;
    }
    .project-title {
      font-size: 32px;
    }
  }
</style>
